@startuml SequenceReturn
actor "Staff (Librarian/Asst)" as Staff
participant ":LibraryRenderer" as UI
participant ":CirculationController" as Controller
participant ":Catalog" as Catalog
participant "c:Copy" as Copy
participant "l:Loan" as Loan
participant "f:Fine" as Fine
participant "b:Book" as Book
participant "r:Reservation" as Reservation
participant ":LibrarySettings" as Settings
participant ":HoldNotifier" as Notifier
participant "s:Student" as Student
participant ":EmailAdapter" as Adapter
participant ":EmailService" as Service

Staff -> UI: return copy (scan barcode)
activate UI
UI -> Controller: returnCopy(barcode)
activate Controller

Controller -> Catalog: findCopy(barcode)
activate Catalog
Catalog --> Controller: c
deactivate Catalog

alt c == null (unknown barcode)
    Controller --> UI: null (refused)
else c found
    Controller -> Copy: currentLoan()
    activate Copy
    Copy --> Controller: l
    deactivate Copy

    alt l == null or l already returned
        Controller --> UI: null (refused)
    else active loan
        Controller -> Loan: close(today)
        activate Loan
        deactivate Loan

        Controller -> Loan: isOverdue(today)
        activate Loan
        Loan --> Controller: late
        deactivate Loan

        opt late == true
            Controller -> Loan: daysLate(today)
            activate Loan
            Loan --> Controller: days
            deactivate Loan

            Controller -> Settings: calculateFine(days)
            activate Settings
            Settings --> Controller: amount
            deactivate Settings

            Controller -> Loan: createFine(amount)
            activate Loan
            Loan -> Fine: new Fine(amount)
            activate Fine
            Fine --> Loan: f
            deactivate Fine
            Loan --> Controller: f
            deactivate Loan
        end

        Note over Copy: l is closed, so c is available again\nunless a student is waiting for it

        Controller -> Copy: getBook()
        activate Copy
        Copy --> Controller: b
        deactivate Copy

        Controller -> Book: nextReservation()
        activate Book
        Book --> Controller: r
        deactivate Book

        alt r != null (a student is waiting)
            Controller -> Settings: calculateHoldDueDate(today)
            activate Settings
            Settings --> Controller: holdDueDate
            deactivate Settings

            Controller -> Reservation: hold(holdDueDate, c)
            activate Reservation
            deactivate Reservation
            Note over Copy,Reservation: c is now held for r,\nso c is not available

            Controller -> Notifier: notify(r)
            activate Notifier

            Notifier -> Reservation: getStudent()
            activate Reservation
            Reservation --> Notifier: s
            deactivate Reservation

            Notifier -> Student: getEmail()
            activate Student
            Student --> Notifier: emailAddr
            deactivate Student

            Notifier -> Adapter: sendTo(emailAddr, "Your reserved copy is ready")
            activate Adapter
            Adapter -> Service: deliver({recipients: [emailAddr],\nsubject, body})
            activate Service
            Service --> Adapter: mail
            deactivate Service
            Adapter --> Notifier
            deactivate Adapter

            Notifier --> Controller
            deactivate Notifier

        else r == null (nobody waiting)
            Note over Copy: c stays on the shelf
        end

        Controller --> UI: f (fine, if any)
    end
end

deactivate Controller
UI --> Staff: return recorded
deactivate UI

@enduml
