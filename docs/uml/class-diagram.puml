@startuml LibrarySystem

class LibraryController {
    + search(title: String): Book[]
    + checkAvailability(b: Book): boolean
    + reserveBook(s: Student, b: Book): Reservation
    + cancelReservation(r: Reservation)
    + viewLoans(s: Student): Loan[]
    + viewStudentReservations(s: Student): Reservation[]
    + lendCopy(barcode: String, s: Student): Loan
    + returnCopy(barcode: String): Fine
    + viewFines(s: Student): Fine[]
    + payFine(f: Fine)
    + waiveFine(f: Fine)
    + viewBookReservations(isbn: String): Reservation[]
    + addBook(title: String, isbn: String, author: String)
    + editBook(isbn: String, title: String, author: String)
    + removeBook(isbn: String)
    + addCopy(isbn: String, barcode: String)
    + markDamagedCopy(barcode: String)
    + viewCopies(isbn: String): Copy[]
    + changeSettings(loanPeriod: int, holdPeriod: int, fineRate: double)
}

class ReminderScheduler {
    + checkOverdueLoans(today: Date)
    + checkExpiredHolds(today: Date)
}

class EmailSender {
    + sendTo(to: String, message: String)
}

class Catalog {
    + search(title: String): Book[]
    + findCopy(barcode: String): Copy
    + findBook(isbn: String): Book
    + addBook(title: String, isbn: String, author: String)
    + findOverdueLoans(today: Date): Loan[]
    + findExpiredHolds(today: Date): Reservation[]
}

class LibrarySettings {
    - loanPeriod: int
    - holdPeriod: int
    - fineRate: double
    + update(loanPeriod: int, holdPeriod: int, fineRate: double)
    + calculateLoanDueDate(start: Date): Date
    + calculateHoldDueDate(start: Date): Date
    + calculateFine(daysLate: int): double
}

class Book {
    - title: String
    - isbn: String
    - author: String
    - withdrawn: boolean
    + isAvailable(): boolean
    + reserve(s: Student): Reservation
    + nextReservation(): Reservation
    + getReservations(): Reservation[]
    + addCopy(barcode: String): Copy
    + getCopies(): Copy[]
    + findAvailableCopy(): Copy
    + edit(title: String, author: String)
    + canBeWithdrawn(): boolean
    + withdraw()
}

class Student {
    - fullName: String
    - studentId: int
    - email: String
    + getLoans(): Loan[]
    + getReservations(): Reservation[]
    + getFines(): Fine[]
    + getEmail(): String
}

class Reservation {
    - reservedOn: Date
    - holdDueDate: Date
    - status: String
    + hold(holdDueDate: Date, c: Copy)
    + expire(today: Date)
    + cancel()
    + getStudent(): Student
    + complete() 
    + getCopy(): Copy   
}

class Copy {
    - barcode: String
    - damaged: boolean
    + isAvailable(): boolean
    + lendTo(s: Student, dueDate: Date): Loan
    + currentLoan(): Loan
    + markDamaged()
    + canLendTo(s: Student): boolean
    + isInUse(): boolean
    + getBook(): Book
}

class Loan {
    - startDate: Date
    - dueDate: Date
    - returnedDate: Date
    + close(today: Date)
    + isOverdue(today: Date): boolean
    + daysLate(today: Date): int
    + createFine(amount: double): Fine
    + getStudent(): Student
}

class Fine {
    - amount: double
    - paid: boolean
    - waived: boolean
    + waive()
    + pay()
}


LibraryController "1" -- "1" EmailSender
LibraryController "1" -- "1" Catalog
LibraryController "1" -- "1" LibrarySettings
LibraryController ..> Book
LibraryController ..> Copy

ReminderScheduler "1" -- "1" EmailSender
ReminderScheduler "1" -- "1" Catalog
ReminderScheduler "1" -- "1" LibrarySettings
ReminderScheduler ..> Loan

Catalog "1" *-- "0..*" Book
Catalog ..> Copy

Book "1" *-- "0..* {ordered}" Reservation : waitingLine
Book "1" *-- "0..*" Copy : has
Reservation "0..1" -- "0..1" Copy : holds

Student "1" -- "0..*" Reservation
Student "1" -- "0..*" Loan : borrows

Copy "1" -- "0..*" Loan : lent in
Loan "1" *-- "0..1" Fine

@enduml
