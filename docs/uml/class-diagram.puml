@startuml LibrarySystem

class Student {
    - fullName: String
    - studentId: int
    - email: String
    + viewLoans(): Loan[]
    + viewReservations(): Reservation[]
}


class Book {
    - title: String
    - isbn: String
    - author: String
    + isAvailable(): boolean
    + reserve(s: Student): Reservation
    + nextReservation(): Reservation
}

class Copy {
    - barcode: String
    - damaged: boolean
    + isAvailable(): boolean
    + lendTo(s: Student, dueDate: Date): Loan
}



class Reservation {
    - reservedOn: Date
    - holdDueDate: Date
    - status: String
    + hold(holdDueDate: Date, c: Copy)
    + expire(today: Date)
    + cancel()
}




class Loan {
    - startDate: Date
    - dueDate: Date
    - returnedDate: Date
    + close(today: Date)
    + isOverdue(today: Date): boolean
    + daysLate(today: Date): int
}


class Fine {
    - amount: double
    - paid: boolean
    - waived: boolean
    + waive()
}

class Catalog {
    + search(title: String): Book[]
    + findCopy(barcode: String): Copy
}
class Librarian {
    - fullName: String
    - librarianId: int

}

class AssistantLibrarian {
    - fullName: String
    - assistantId: int
}

class LibrarySettings {
    - loanPeriod: int
    - holdPeriod: int
    - fineRate: double
    + changeFineRates(rate: double)
    + changeLoanPeriods(days: int)
    + changeHoldPeriod(days: int)
    + calculateLoanDueDate(start: Date): Date
    + calculateHoldDueDate(start: Date): Date
    + calculateFine(daysLate: int): double

}
class EmailSender {
    + sendTo(to: String, message: String)
}


@enduml
